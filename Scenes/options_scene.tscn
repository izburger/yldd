[sub_resource type="GDScript" id="GDScript_7bvvr"]
script/source = "extends Node2D

func _on_button_toggled(toggled_on: bool) -> void:
	Global.your_taste = \"Sweet\"
	print(Global.your_taste)

func _on_button_2_toggled(toggled_on: bool) -> void:
	Global.your_taste = \"Sour\"
	print(Global.your_taste)


func _on_button_3_toggled(toggled_on: bool) -> void:
	Global.your_taste = \"Spicy\"
	print(Global.your_taste)

func _on_button_4_toggled(toggled_on: bool) -> void:
	Global.your_taste = \"Bland\"
	print(Global.your_taste)


func _on_button_5_toggled(toggled_on: bool) -> void:
	Global.your_ganda = \"Comedy\"
	print(Global.your_ganda)

func _on_button_6_toggled(toggled_on: bool) -> void:
	Global.your_ganda = \"Mystery\"
	print(Global.your_ganda)


func _on_button_7_toggled(toggled_on: bool) -> void:
	Global.your_ganda = \"Horror\"
	print(Global.your_ganda)


func _on_button_8_toggled(toggled_on: bool) -> void:
	Global.your_ganda = \"Drama\"
	print(Global.your_ganda)


func _on_button_9_toggled(toggled_on: bool) -> void:
	Global.your_experience = \"Fear\"
	print(Global.your_experience)


func _on_button_10_toggled(toggled_on: bool) -> void:
	Global.your_experience = \"Disgust\"
	print(Global.your_experience)


func _on_button_11_toggled(toggled_on: bool) -> void:
	Global.your_experience = \"Satisfaction\"
	print(Global.your_experience)


func _on_button_12_toggled(toggled_on: bool) -> void:
	Global.your_experience = \"Nothing\"
	print(Global.your_experience)


func _on_button_13_toggled(toggled_on: bool) -> void:
	Global.your_feeling = \"Sadness\"
	print(Global.your_feeling)


func _on_button_14_toggled(toggled_on: bool) -> void:
	Global.your_feeling = \"Fear\"
	print(Global.your_feeling)


func _on_button_15_toggled(toggled_on: bool) -> void:
	Global.your_feeling = \"Happiness\"
	print(Global.your_feeling)


func _on_button_16_toggled(toggled_on: bool) -> void:
	Global.your_feeling = \"Nothing\"
	print(Global.your_feeling)


func _on_confirm_pressed() -> void:
	get_tree().change_scene_to_file(\"res://Scenes/SceneBeforeMain.tscn\")
"

